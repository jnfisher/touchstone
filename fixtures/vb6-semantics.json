{
 "format": 1,
 "comment": "VB6 semantics contract shared by tools/oracle and crates/touchstone-vb6. Numbers compare exactly. A case has either result or error (a VB6 run-time error number: 5 invalid procedure call, 6 overflow, 11 division by zero). confidence low marks behaviour VB6 documentation does not pin down; both implementations still follow the table. Cases with a note explain a subtle rule.",
 "errors": {
  "5": "Invalid procedure call or argument",
  "6": "Overflow",
  "11": "Division by zero"
 },
 "ops": {
  "CInt": "[Double] -> Integer; banker's rounding; error 6 outside -32768..32767",
  "CLng": "[Double] -> Long; banker's rounding; error 6 outside the 32-bit range",
  "AssignInteger": "[Double] -> Integer; implicit conversion on assignment, same rounding as CInt",
  "AssignLong": "[Double] -> Long; implicit conversion on assignment, same rounding as CLng",
  "CSng": "[Double] -> Single (shown as the exact Double value of the f32)",
  "CCur": "[Double] -> Currency (shown as a Double); rounded to 4 decimals",
  "CBool": "[number|bool] -> -1 or 0",
  "Int": "[Double] -> floor as Double",
  "Fix": "[Double] -> truncate toward zero as Double",
  "Abs": "[Double] -> Double",
  "Sgn": "[Double] -> Integer -1/0/1",
  "Sqr": "[Double]; error 5 if negative",
  "Log": "[Double]; error 5 if <= 0",
  "Exp": "[Double]; error 6 on overflow",
  "Round": "[x] or [x, digits] -> Double; banker's; error 5 if digits < 0",
  "IntDiv": "[a, b] operands rounded to Long (error 6 if out of range), b = 0 is error 11, quotient truncated, Long result",
  "IntDivInt": "[a, b] both Integer-typed (within -32768..32767); Integer result",
  "Mod": "[a, b] operands rounded to Long; sign follows the dividend; b = 0 is error 11",
  "AddInt": "[a, b] Integer-typed operands, Integer result, error 6 on overflow",
  "SubInt": "as AddInt",
  "MulInt": "as AddInt; the product is Integer even if assigned to a Long",
  "AddLng": "[a, b] Long-typed operands, Long result, error 6 on overflow",
  "SubLng": "as AddLng",
  "MulLng": "as AddLng",
  "Div": "[a, b] -> Double; error 11 if b = 0",
  "Pow": "[a, b] -> Double; 0^negative is error 11, overflow error 6",
  "Eq": "[a, b] -> -1 or 0",
  "Ne": "as Eq",
  "Lt": "as Eq",
  "Le": "as Eq",
  "Gt": "as Eq",
  "Ge": "as Eq",
  "And": "[a, b] bitwise on Long after rounding",
  "Or": "as And",
  "Xor": "as And",
  "Not": "[a] bitwise complement on Long (Integer range gives the same answer)",
  "AddSng": "[a, b] Single-typed operands, Single result",
  "MulSng": "as AddSng",
  "DivSng": "as AddSng; error 11 if b = 0, 6 on overflow",
  "AddCur": "[a, b] Currency operands (decimals with <= 4 places), Currency result as Double; error 6 on overflow",
  "MulCur": "as AddCur",
  "DivCur": "as AddCur; error 11 if b = 0",
  "CStr": "[number|bool] -> String",
  "Str": "[number] -> String with leading sign space",
  "Concat": "[pieces...] -> String; numbers via CStr, bools as True/False, strings as is",
  "Val": "[String] -> Double",
  "Left": "[s, n]",
  "Right": "[s, n]",
  "Mid": "[s, start] or [s, start, len]; 1-based",
  "Len": "[s] -> Long",
  "IIf": "[cond, a, b] -> a if cond is non-zero/true else b",
  "Format": "[Double, pattern] -> String; supports the 0 # , . patterns MME uses",
  "RndScript": "[steps] -> list of outputs, run on a fresh generator. Steps: [\"Rnd\"], [\"Rnd\", n], [\"Randomize\", n] (output null), [\"RandomNumber\", lo, hi]. Rnd outputs are Single values shown exactly"
 },
